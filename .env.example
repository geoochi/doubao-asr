# Doubao dictation configuration.
# Copy to .env (same directory as dictate.py) and fill in DOUBAO_API_KEY.
# .env is gitignored — never commit your key.
# Real environment variables override values in this file.

# --- API ---
DOUBAO_API_KEY=
# Streaming endpoint (used when DOUBAO_RECOGNIZE=stream).
DOUBAO_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# One-shot endpoint (used when DOUBAO_RECOGNIZE=batch).
DOUBAO_BATCH_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
DOUBAO_RESOURCE_ID=volc.seedasr.sauc.duration

# --- Audio ---
# "default" follows the system default source, or a PulseAudio source name.
DOUBAO_DEVICE=default
DOUBAO_SAMPLE_RATE=16000
# Audio chunk size streamed per packet.
DOUBAO_SEGMENT_MS=200
# Safety cap; recording stops by itself after this many seconds.
DOUBAO_MAX_DURATION_SECS=120
# "batch" = record the whole utterance, then send it once (best accuracy, no
# live text). "stream" = send audio live and type as you speak.
DOUBAO_RECOGNIZE=batch
# Only used by the streaming path: Doubao's non-stream second pass.
DOUBAO_ENABLE_NONSTREAM=false

# --- Output ---
# "type" (wtype keystrokes at the cursor) or "clipboard" (wl-copy).
DOUBAO_MODE=type
# Stream mode only: type incrementally while you speak (false = once at the end).
DOUBAO_STREAM_TYPING=true
# Stream mode only: debounce before typing an update, in ms.
DOUBAO_FLUSH_DELAY_MS=350

# --- Feedback ---
DOUBAO_NOTIFY=true
DOUBAO_SOUND=false

# --- Debug ---
# Save each session's mic audio as WAV under
# ~/.local/state/doubao-dictate/sessions/ (keeps the last 20).
DOUBAO_SAVE_AUDIO=false
